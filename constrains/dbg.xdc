# 1. Запрещаем оптимизировать отладочный хаб и ядро ILA
set_property DONT_TOUCH true [get_cells dbg_hub]

# 2. Задаем частоту для JTAG хаба (чтобы он не ждал клок от Zynq)












set_false_path -from [get_clocks clk_pl_0] -to [get_clocks -of_objects [get_pins d_1_i/rls_mini_dsp/inst/u_ddr4/inst/u_ddr4_infrastructure/gen_mmcme4.u_mmcme_adv_inst/CLKOUT0]]

####################################################################################
# Constraints from file : 'xpm_cdc_async_rst.tcl'
####################################################################################

set_false_path -from [get_clocks -of_objects [get_pins d_1_i/rls_mini_dsp/inst/u_ddr4/inst/u_ddr4_infrastructure/gen_mmcme4.u_mmcme_adv_inst/CLKOUT0]] -to [get_clocks clk_pl_0]
connect_debug_port u_ila_0/clk [get_nets [list u_ila_0_input_rst_mmcm_reg_0]]
connect_debug_port u_ila_1/clk [get_nets [list u_ila_1_pl_clk0]]

